# Copy the keys you need into .env (which is gitignored). Operator login
# credentials are NOT here — those live in .env.auth, created by
# `python -m app.core.setup_auth`.

# --- Database (required) ---
DATABASE_URL=postgresql+psycopg2://madre_tierra_user:PASSWORD@localhost:5432/madre_tierra_db

# --- Frontend origins allowed to call the API ---
# The Vite dev server proxies /api, so this only matters if you serve the
# built frontend from a different origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Company details printed on invoices ---
COMPANY_NAME=Madre Tierra
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
CURRENCY=$

# --- Outgoing email, for invoices and client broadcasts ---
# Gmail: use an App Password (not your account password) with
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true.
# Leave SMTP_HOST empty to disable sending; the Messages page will say so.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
